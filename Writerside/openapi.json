{
    "openapi": "3.0.0",
    "info": {
        "title": "API Documentation",
        "version": "1.0.0",
        "description": "API Documentation for Writerside"
    },
    "servers": [
        {
            "url": "https://api.example.com/v1",
            "description": "Production Server"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Login a user",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User logged in successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "access_token": {
                                            "type": "string",
                                            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "Bearer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Logout a user",
                "responses": {
                    "200": {
                        "description": "User logged out successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logged out successfully"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/user": {
            "get": {
                "tags": [
                    "auth"
                ],
                "summary": "Get authenticated user",
                "responses": {
                    "200": {
                        "description": "Authenticated user retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/apiaries": {
            "get": {
                "tags": [
                    "apiaries"
                ],
                "summary": "Get all apiaries",
                "responses": {
                    "200": {
                        "description": "List of apiaries",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Apiary"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "apiaries"
                ],
                "summary": "Create a new apiary",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApiaryRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Apiary created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Apiary"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/apiaries/{id}": {
            "get": {
                "tags": [
                    "apiaries"
                ],
                "summary": "Get a specific apiary",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Apiary details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Apiary"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "apiaries"
                ],
                "summary": "Update a specific apiary",
                "parameters": [
                    {
                        "name": "apiaryId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApiaryRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Apiary updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Apiary"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "apiaries"
                ],
                "summary": "Delete a specific apiary",
                "parameters": [
                    {
                        "name": "apiaryId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Apiary deleted successfully"
                    }
                }
            }
        },
        "/hives": {
            "get": {
                "tags": [
                    "hives"
                ],
                "summary": "Get all hives",
                "responses": {
                    "200": {
                        "description": "List of hives",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Hive"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "hives"
                ],
                "summary": "Create a new hive",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/HiveRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Hive created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Hive"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/hives/{hiveId}": {
            "get": {
                "tags": [
                    "hives"
                ],
                "summary": "Get a specific hive",
                "parameters": [
                    {
                        "name": "hiveId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hive details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Hive"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "hives"
                ],
                "summary": "Update a specific hive",
                "parameters": [
                    {
                        "name": "hiveId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/HiveRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Hive updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Hive"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "hives"
                ],
                "summary": "Delete a specific hive",
                "parameters": [
                    {
                        "name": "hiveId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Hive deleted successfully"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "firstname": {
                        "type": "string",
                        "example": "John"
                    },
                    "lastname": {
                        "type": "string",
                        "example": "Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    }
                }
            },
            "Apiary": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "My Apiary"
                    },
                    "latitude": {
                        "type": "string",
                        "example": "-46.9457330"
                    },
                    "longitude": {
                        "type": "string",
                        "example": "-99.6887280"
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 1
                    }
                }
            },
            "Hive": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "My Hive"
                    },
                    "installation_date": {
                        "type": "string",
                        "example": "2021-01-01"
                    },
                    "in_use": {
                        "type": "boolean",
                        "example": true
                    },
                    "latitude": {
                        "type": "string",
                        "example": "-46.9457330"
                    },
                    "longitude": {
                        "type": "string",
                        "example": "-99.6887280"
                    },
                    "apiary_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "apiary": {
                        "$ref": "#/components/schemas/Apiary"
                    }
                }
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "firstname": {
                        "type": "string",
                        "example": "John"
                    },
                    "lastname": {
                        "type": "string",
                        "example": "Doe"
                    },
                    "email": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "example": "password123"
                    }
                }
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "example": "john.doe@example.com"
                    },
                    "password": {
                        "type": "string",
                        "example": "password123"
                    }
                }
            },
            "ApiaryRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "My Apiary"
                    },
                    "latitude": {
                        "type": "string",
                        "example": "-46.9457330"
                    },
                    "longitude": {
                        "type": "string",
                        "example": "-99.6887280"
                    }
                }
            },
            "HiveRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "My Hive"
                    },
                    "installation_date": {
                        "type": "string",
                        "example": "2021-01-01"
                    },
                    "in_use": {
                        "type": "boolean",
                        "example": true
                    },
                    "latitude": {
                        "type": "string",
                        "example": "-46.9457330"
                    },
                    "longitude": {
                        "type": "string",
                        "example": "-99.6887280"
                    },
                    "apiary_id": {
                        "type": "integer",
                        "example": 1
                    }
                }
            },
            "ValidationError": {
                "type": "object",
                "properties": {
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    }
}
